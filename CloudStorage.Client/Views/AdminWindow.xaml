<Window x:Class="CloudStorage.Client.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource MaterialDesignWindow}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CloudStorage.Client.Views"
        mc:Ignorable="d"
        xmlns:models="clr-namespace:CloudStorage.Client.Models"
        WindowStartupLocation="CenterScreen"
        xmlns:ui="clr-namespace:CloudStorage.Client.UI"
        xmlns:conv="clr-namespace:CloudStorage.Client.Converters"
        xmlns:viewModels="clr-namespace:CloudStorage.Client.ViewModels"
        d:DataContext="{d:DesignInstance viewModels:AdminViewModel, IsDesignTimeCreatable=True}"
        Title="Панель админа" Height="800" Width="1200" Loaded="Window_Loaded">
    <Window.Resources>
        <conv:ButtonIsBanConverter x:Key="banconv"/>
        <conv:BoolToWordConverter x:Key="wordconv"/>
        <conv:BoolToColorConverter x:Key="colorconv"/>
        <conv:AdminWordBoolConverter x:Key="adminconv"/>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Menu>
                    <MenuItem Height="30" Header="Аккаунт">
                        <MenuItem Command="{Binding LogoutCommand}" Height="30" Header="Выйти из аккаунта"/>
                    </MenuItem>
                </Menu>
            </Grid>


            <StackPanel Grid.Row="1">
                <TextBlock FontSize="20" HorizontalAlignment="Center" Padding="0 20" Text="Список пользователей"/>
                <DataGrid x:Name="DG" FontSize="17" ItemsSource="{Binding AdminUsers}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                        <DataGridTextColumn Header="Админ" Binding="{Binding IsAdmin, Converter={StaticResource wordconv}}"/>
                        <DataGridTextColumn Header="Забанен" Binding="{Binding IsBan, Converter={StaticResource wordconv}}"/>
                        <DataGridTemplateColumn Header="Диск">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenDiskCommand, ElementName=DG}" CommandParameter="{Binding}" Style="{StaticResource BaseBtn}" Content="Открыть диск"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Допуск">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button BorderThickness="0" Command="{Binding DataContext.BanUnbanUserCommand, ElementName=DG}" Background="{Binding IsBan, Converter={StaticResource colorconv}}" CommandParameter="{Binding}" Style="{StaticResource BaseBtn}" Content="{Binding IsBan, Converter={StaticResource banconv}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Админ">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button BorderThickness="0" Command="{Binding DataContext.AdminUnadminUserCommand, ElementName=DG}" Background="{Binding IsAdmin, Converter={StaticResource colorconv}}" CommandParameter="{Binding}" Style="{StaticResource BaseBtn}" Content="{Binding IsAdmin, Converter={StaticResource adminconv}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
