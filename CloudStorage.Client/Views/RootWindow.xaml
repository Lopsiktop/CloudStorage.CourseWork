<Window x:Class="CloudStorage.Client.Views.RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CloudStorage.Client.Views"
        Style="{StaticResource MaterialDesignWindow}"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:CloudStorage.Client.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        xmlns:ui="clr-namespace:CloudStorage.Client.UI"
        d:DataContext="{d:DesignInstance viewModels:RootViewModel, IsDesignTimeCreatable=True}"
        Title="Главная" Height="600" Width="1000">
    <Grid>
        <TabControl TabStripPlacement="Left">
            <TabItem Width="200" Header="Главная"></TabItem>
            <TabItem Width="200" Header="Диск"></TabItem>
            <TabItem Width="200" Header="Профиль"></TabItem>
        </TabControl>
    </Grid>
</Window>
