<Window x:Class="CloudStorage.Client.Views.PropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CloudStorage.Client.Views"
        xmlns:conv="clr-namespace:CloudStorage.Client.Converters"
        xmlns:viewModels="clr-namespace:CloudStorage.Client.ViewModels"
        mc:Ignorable="d" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner"
        Title="Свойства" Width="400" Height="Auto" AllowsTransparency="True" Background="Transparent"
        d:DataContext="{d:DesignInstance viewModels:PropertyViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <conv:FileToIconConverter x:Key="imgconv"/>
        <conv:BoolToVisibleConverter x:Key="visconv"/>
        <conv:BoolToVisibleDescConverter x:Key="descconv"/>
        <conv:BytesToStandardConverter x:Key="byteconv"/>
        <conv:DateConverter x:Key="dateconv"/>
    </Window.Resources>
    <Border Height="470" BorderThickness="1" BorderBrush="GreenYellow" Background="White" CornerRadius="10" Padding="30">
        <Grid>
            <StackPanel>
                <TextBlock FontSize="22" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="{Binding Name, StringFormat='Свойства: {0}'}"/>
                <StackPanel Orientation="Horizontal" Margin="0 20">
                    <Image Visibility="{Binding IsFile, Converter={StaticResource visconv}}" Width="50" Source="{Binding Name, Converter={StaticResource imgconv}}"/>
                    <Image Visibility="{Binding IsFile, Converter={StaticResource descconv}}" Width="50" Source="/Resources/Images/folder.png"/>
                    <TextBlock Width="277" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" FontSize="18" Margin="10 0" VerticalAlignment="Center" Text="{Binding Name}"/>
                </StackPanel>
                <Separator/>
                <StackPanel Margin="0 10 0 0" Orientation="Horizontal">
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="Тип: "/>
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Margin="10 0" Grid.Column="1" Visibility="{Binding IsFile, Converter={StaticResource visconv}}" Text="Файл"/>
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Margin="10 0" Grid.Column="1" Visibility="{Binding IsFile, Converter={StaticResource descconv}}" Text="Папка"/>
                </StackPanel>
                <StackPanel Margin="0 10" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="Расположение: "/>
                    <TextBlock Width="211" FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Margin="10 0" Grid.Column="1" Text="{Binding Path}"/>
                </StackPanel>
                <Separator/>
                <StackPanel Margin="0 10" Orientation="Horizontal">
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="Размер: "/>
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Margin="10 0" Grid.Column="1" Text="{Binding Size, Converter={StaticResource byteconv}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsFile, Converter={StaticResource descconv}}" Margin="0 0 0 10" Orientation="Horizontal">
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="Содержит: "/>
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis"  TextWrapping="WrapWithOverflow" Margin="10 0" Text="{Binding FilesContains, StringFormat='Файлов: {0};'}"/>
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="{Binding FolderContains, StringFormat='Папок: {0}'}"/>
                </StackPanel>
                <Separator/>
                <StackPanel Margin="0 10" Orientation="Horizontal">
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="Создан: "/>
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Margin="10 0" Grid.Column="1" Text="{Binding CreatedDate, Converter={StaticResource dateconv}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsFile, Converter={StaticResource visconv}}" Margin="0 0 0 10" Orientation="Horizontal">
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Text="Изменен: "/>
                    <TextBlock FontSize="16" TextTrimming="WordEllipsis" TextWrapping="WrapWithOverflow" Margin="10 0" Grid.Column="1" Text="{Binding ModifiedDate, Converter={StaticResource dateconv}}"/>
                </StackPanel>
            </StackPanel>
            <Button Click="Button_Click" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="100" Margin="0 20 0 0" Style="{StaticResource BaseBtn}" Content="ОК"/>
        </Grid>
    </Border>
</Window>
