<UserControl x:Class="CloudStorage.Client.UI.Notification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CloudStorage.Client.UI"
             mc:Ignorable="d">
    <Border CornerRadius="2" Name="MainBorder" d:Visibility="Visible" BorderBrush="LightGray" BorderThickness="1" Background="Green" Margin="10" Width="300" HorizontalAlignment="Right" VerticalAlignment="Top">
        <StackPanel Margin="30 20">
            <TextBlock Foreground="White" Name="TitleBox" FontWeight="SemiBold" FontSize="18" Text="Уведомление"/>
            <TextBlock Foreground="White" TextWrapping="WrapWithOverflow" Name="MessageBox" FontSize="14" Margin="0 10 0 0" Text="Неверный логин или пароль"/>
        </StackPanel>
    </Border>
</UserControl>
