<Window x:Class="CloudStorage.Client.UI.Modals.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CloudStorage.Client.UI.Modals"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner"
        Title="Confirmation" Width="400" Height="180" AllowsTransparency="True" Background="Transparent">
    <Border BorderThickness="1" BorderBrush="GreenYellow" Background="White" CornerRadius="10">
        <StackPanel Margin="20" Orientation="Vertical">
            <TextBlock FontSize="20" Text="Поделиться"/>
            <DockPanel>
                <Button Click="DeleteLink_Click" ToolTip="Удалить ссылку" DockPanel.Dock="Right"  Margin="10 0 0 0" Command="{Binding SearchCommand}" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}" Width="40">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Direction="0" />
                    </Button.Effect>
                    <md:PackIcon HorizontalAlignment="Center" VerticalAlignment="Center" Width="25" Height="25" Kind="Trash"/>
                </Button>
                <TextBox FontSize="13.5" IsReadOnly="True" DockPanel.Dock="Left" Name="UrlBox" Margin="0 20" />
            </DockPanel>
            <Button Click="CloseWindow_Click" Margin="0 10 0 0" Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedButton}" Content="Закрыть окно"/>
        </StackPanel>
    </Border>
</Window>
